# ==========================================
# Application Configuration
# ==========================================
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ==========================================
# Microsoft Foundry
# ==========================================
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_AGENT_NAME=smart-media-agent

# ==========================================
# Azure OpenAI 
# ==========================================
AZURE_OPENAI_ENDPOINT=https://<your-resource-name>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-azure-openai-key>
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# ==========================================
# Azure AI Search
# ==========================================
AZURE_SEARCH_ENDPOINT=https://<your-search-service>.search.windows.net
AZURE_SEARCH_API_KEY=<your-azure-search-key>
AZURE_SEARCH_INDEX_NAME=educational-content-index

# ==========================================
# Azure AI Document Intelligence 
# ==========================================
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://<your-doc-intel-service>.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=<your-doc-intel-key>

# ==========================================
# Azure AI Speech (Optional)
# ==========================================
AZURE_SPEECH_KEY=<your-speech-key>
AZURE_SPEECH_REGION=eastus

# ==========================================
# Local Storage
# ==========================================
UPLOAD_DIR=./storage/uploads
DATABASE_URL=sqlite:///./storage/app.db
